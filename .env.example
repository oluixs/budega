# Copie este arquivo para .env.local (web) e/ou .env (mobile) e preencha os valores.
# Sem estas variáveis, o app roda em modo mock (dados de demonstração), sem erro.

# --- Web (apps/web) — Next.js exige o prefixo NEXT_PUBLIC_ para variáveis do cliente ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: ativa o mapa em /explorar e nas páginas de mercado. Sem isso, a lista
# continua funcionando normalmente com um fallback (endereço + distância + botão de rota).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Mobile (apps/mobile) — Expo exige o prefixo EXPO_PUBLIC_ para variáveis do cliente ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Apenas para scripts administrativos locais (packages/supabase) ---
# NUNCA prefixe estas com NEXT_PUBLIC_/EXPO_PUBLIC_ nem as exponha no cliente.
# Connection string do Postgres do projeto Supabase (Project Settings > Database).
DATABASE_URL=
# service_role key (Project Settings > API) — usada apenas por scripts/seed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
